# ---------------------------------------------------------------------------
# Image versions  (pinned here so they are trivial to bump if a tag is missing)
# ---------------------------------------------------------------------------
KAFKA_IMAGE=apache/kafka:3.8.0
REDIS_IMAGE=redis:7-alpine
NEO4J_IMAGE=neo4j:5-community
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8
FLINK_VERSION=1.19.1
GRAFANA_IMAGE=grafana/grafana:11.1.0

# ---------------------------------------------------------------------------
# Credentials  (DEVELOPMENT ONLY — do not reuse in any real environment)
# ---------------------------------------------------------------------------
NEO4J_PASSWORD=fraud_neo4j
CLICKHOUSE_USER=fraud
CLICKHOUSE_PASSWORD=fraud_ch
CLICKHOUSE_DB=fraud
GRAFANA_PASSWORD=admin

# Payload encryption key, AES-256 (64 hex characters). DEVELOPMENT ONLY - it is
# in the source tree, so it protects nothing. A deployment sources this from a
# KMS or HSM with rotation.
#
# Setting it does NOT turn encryption on. The consuming side detects encrypted
# records by their envelope prefix and decrypts only those, so the key can be
# present on the cluster permanently while the producer decides per run whether
# to encrypt (`kafka_producer.py --encrypt`). That asymmetry is what lets the
# two arms of the security-overhead measurement run against one deployment.
PAYLOAD_KEY_HEX=2b87fdd43b92e656fe7f6cccf7e5e791cbbc53e301dd01203852cc8d3713cb5f

# ---------------------------------------------------------------------------
# Host ports  (left side of the mapping — change if a port is already in use)
# ---------------------------------------------------------------------------
KAFKA_HOST_PORT=29092
REDIS_HOST_PORT=6379
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
FLINK_UI_PORT=8081
GRAFANA_PORT=3000
