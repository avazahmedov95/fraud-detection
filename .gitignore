# ---------------------------------------------------------------------------
# Generated and large datasets.
# banks.csv is REAL input data (CBU card figures) that config.py loads, so it
# is tracked deliberately — a blanket `*.csv` rule would silently drop it and
# make the generator fall back to synthetic banks.
# ---------------------------------------------------------------------------
# generator --out can point anywhere: out/, out_check/, ...
data-generator/out*/
validation/*.csv
# What the adapters download and what --extract-only writes beside them:
# sidecar files and cached feature matrices.
validation/*_Patterns.txt
validation/*.npz

# Python
__pycache__/
*.pyc
.venv*/
venv/
.pytest_cache/

# ---------------------------------------------------------------------------
# ML artifacts. Weights and plots are regenerable from train.py; the result
# JSONs (metrics, ablation, seeds, recall-by-type) are the evidence quoted in
# the thesis and are tracked.
# ---------------------------------------------------------------------------
ml/models/*.joblib
ml/models/*.onnx
ml/models/*.txt
# manifest.json is the PROVENANCE record and IS tracked - it is what says the
# untracked artefacts above belonged together.
!ml/models/manifest.json
ml/models/*.png

# OS / editor
.DS_Store
.idea/
.vscode/

# deployed model artifacts (copied from ml/models at deploy)
stream-processor/model.onnx
stream-processor/thresholds.json

# TLS material for the mutual-TLS arm (regenerate with `run.ps1 make-certs`).
# The CA private key lives here alongside the certificates it signs, which is
# acceptable only because this is a throwaway development CA - and precisely
# why it must never be committed.
infra/kafka/certs/

# Editor and shell scratch.
*.tmp

# Run state, not source: experiments/outage.py rewrites the baseline snapshot on
# every round, so tracking it means a dirty tree after every experiment.
stream-processor/fault_injection_state.json
stream-processor/throughput_windows.json

# Warehouse export taken before the 2026-09-07 truncation, so the audit anchor
# in docs/audit-anchors.md stays recomputable. See that file.
_warehouse_backup_*/
