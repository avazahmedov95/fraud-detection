# ---------------------------------------------------------------------------
# Generated and large datasets.
# banks.csv is REAL input data (CBU card figures) that config.py loads, so it
# is tracked deliberately — a blanket `*.csv` rule would silently drop it and
# make the generator fall back to synthetic banks.
# ---------------------------------------------------------------------------
# generator --out can point anywhere: out/, out_check/, ...
data-generator/out*/
validation/*.csv
# The public files the adapters read, and the feature caches they write beside them.
validation/*_Patterns.txt
validation/*.npz
# The training-matrix cache second_look.py writes.
ml/*.npz

# Local settings and passwords: copied from .env.example on each machine.
.env

# Python
__pycache__/
*.pyc
.venv*/
venv/
.pytest_cache/

# ---------------------------------------------------------------------------
# ML artifacts. The weights are regenerable from train.py; the JSON files
# (metrics, cut-off, feature names, the second look's band) are tracked.
# ---------------------------------------------------------------------------
ml/models/*.joblib
ml/models/*.onnx
ml/models/*.txt
ml/models/*.npz
ml/models/candidate/
# manifest.json is the PROVENANCE record and IS tracked - it is what says the
# untracked artefacts above belonged together.
!ml/models/manifest.json

# OS / editor
.DS_Store
.idea/
.vscode/

# deployed model artifacts (copied from ml/models at deploy)
stream-processor/model.onnx
stream-processor/thresholds.json
stream-processor/second_look.json

# TLS material for Kafka's mutual-TLS listener (regenerate with `run.ps1 make-certs`).
# The CA private key lives here alongside the certificates it signs, which is
# acceptable only because this is a throwaway development CA - and precisely
# why it must never be committed.
infra/kafka/certs/

# Editor and shell scratch.
*.tmp

# Warehouse exports taken before the 2026-09-07 and 2026-09-12 truncations: the
# evidence behind the audit anchors.
_warehouse_backup_*/
