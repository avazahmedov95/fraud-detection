          "rawSql": "SELECT opened_at AS held_at,\n       concat(substring(receiver_card, 1, 4), ' ', substring(receiver_card, 5, 2),\n              '** **** ', substring(receiver_card, -4)) AS to_card,\n       amount_uzs AS amount_UZS,\n       multiIf(startsWith(model_version, 'second-look'), 'second look (TabPFN)',\n        predicted_type = '', 'the model, no name',\n        transform(toString(predicted_type), ['APP', 'ATO', 'MULE', 'STRUCTURING'],\n                  ['phone scam', 'account takeover', 'money mule', 'split amounts'],\n                  toString(predicted_type))) AS held_by,\n       arrayStringConcat(explanation, '; ') AS reasons,\n       transform(toString(disposition), ['NEW', 'CONFIRMED_FRAUD', 'FALSE_POSITIVE'],\n                 ['waiting', 'blocked: fraud', 'released: false alarm'],\n                 toString(disposition)) AS verdict\nFROM fraud.cases FINAL WHERE decision = 'REVIEW'\nORDER BY opened_at DESC\nLIMIT 50",
          "queryType": "table",
          "refId": "A"
        }
