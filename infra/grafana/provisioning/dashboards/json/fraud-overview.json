    {
      "id": 12,
      "type": "piechart",
      "title": "What held them",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "description": "The fraud type the rules named, the model alone when no rule named it, or the second look.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT multiIf(startsWith(model_version, 'second-look'), 'second look (TabPFN)',\n        predicted_type = '', 'the model, no name',\n        transform(toString(predicted_type), ['APP', 'ATO', 'MULE', 'STRUCTURING'],\n                  ['phone scam', 'account takeover', 'money mule', 'split amounts'],\n                  toString(predicted_type))) AS held_by, count() AS held\nFROM (SELECT transaction_id, decision, predicted_type, model_version, scored_at_job\n FROM fraud.transactions_scored WHERE $__timeFilter(scored_at_job)\n ORDER BY scored_at DESC LIMIT 1 BY transaction_id)\nWHERE decision = 'REVIEW'\nGROUP BY held_by\nORDER BY held DESC",
          "queryType": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
