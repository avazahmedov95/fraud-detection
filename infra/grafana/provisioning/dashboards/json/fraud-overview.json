    {
      "id": 7,
      "type": "row",
      "title": "Speed",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "table",
      "title": "How fast the decisions were",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "description": "The share of transfers decided within each time, from arrival to decision. The target is 300 ms, so the last bar should stay empty.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT label, round(100.0 * n / nullIf(total, 0), 1) AS share\nFROM (SELECT count() AS total, countIf(ms < 25) AS c1, countIf(ms >= 25 AND ms < 50) AS c2,\n             countIf(ms >= 50 AND ms < 100) AS c3, countIf(ms >= 100 AND ms < 300) AS c4,\n             countIf(ms >= 300) AS c5\n      FROM (SELECT toUnixTimestamp64Milli(scored_at_job) - toUnixTimestamp64Milli(ingested_at) AS ms FROM fraud.transactions_scored\n            WHERE $__timeFilter(scored_at_job) AND toUnixTimestamp64Milli(ingested_at) > 0\n  AND NOT startsWith(model_version, 'second-look')))\nARRAY JOIN ['under 25 ms', '25 to 50 ms', '50 to 100 ms', '100 to 300 ms', 'over 300 ms'] AS label,\n           [c1, c2, c3, c4, c5] AS n",
          "queryType": "table",
          "format": 1,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "share"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3274D9"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": false,
        "cellHeight": "md"
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Where a decision's time goes, by service (average)",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "description": "Kafka keeps the transfer until Flink takes it in a small batch: almost all of the time. Flink then reads the sender's history from its own memory and the payee's side from Redis, computes the features, checks the rules, runs the model and decides.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT part, round(ms, 2) AS ms\nFROM (SELECT avg(stage_kafka_ms) AS k, avg(stage_handoff_ms) AS h, avg(stage_state_ms) AS s,\n             avg(stage_redis_ms) AS r, avg(stage_rules_ms) AS f, avg(stage_model_ms) AS m,\n             avg(stage_decode_ms + stage_decide_ms) AS d\n      FROM fraud.transactions_scored\n      WHERE $__timeFilter(scored_at_job) AND stage_decide_ms IS NOT NULL)\nARRAY JOIN ['Kafka: into the queue', 'Kafka to Flink: waiting for a batch',\n            'Flink: the sender''s history', 'Redis: the payee''s side',\n            'Flink: features and rules', 'Flink: the model (ONNX)',\n            'Flink: reading and deciding'] AS part,\n           [k, h, s, r, f, m, d] AS ms",
          "queryType": "table",
          "format": 1,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ms"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3274D9"
                }
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": false,
        "cellHeight": "md"
      }
    },
