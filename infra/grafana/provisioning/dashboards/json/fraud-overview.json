    {
      "id": 12,
      "type": "table",
      "title": "Who held the transfers",
      "gridPos": {
        "x": 16,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "description": "The rules name the fraud type; the model can hold a transfer no rule named; the second look checks the transfers just under the alert level.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT multiIf(startsWith(model_version, 'second-look'), 'the second look (TabPFN)',\n        predicted_type = '', 'the model, no fraud type named',\n        concat('the rules: ', transform(toString(predicted_type),\n               ['APP', 'ATO', 'MULE', 'STRUCTURING'],\n               ['phone scam', 'account takeover', 'money mule', 'split amounts'],\n               toString(predicted_type)))) AS held_by, count() AS held\nFROM (SELECT transaction_id, decision, predicted_type, model_version, scored_at_job\n FROM fraud.transactions_scored WHERE $__timeFilter(scored_at_job)\n ORDER BY scored_at DESC LIMIT 1 BY transaction_id)\nWHERE decision = 'REVIEW'\nGROUP BY held_by\nORDER BY held DESC",
          "queryType": "table",
          "format": 1,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "held"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF780A"
                }
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": false,
        "cellHeight": "md"
      }
