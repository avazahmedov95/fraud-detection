    {
      "id": 8,
      "type": "timeseries",
      "title": "Decision time (ms) against the 300 ms target",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT $__timeInterval(scored_at_job) AS time,\n       quantile(0.5)(toUnixTimestamp64Milli(scored_at_job) - toUnixTimestamp64Milli(ingested_at)) AS median,\n       quantile(0.99)(toUnixTimestamp64Milli(scored_at_job) - toUnixTimestamp64Milli(ingested_at)) AS `99%`\nFROM fraud.transactions_scored\nWHERE $__timeFilter(scored_at_job) AND toUnixTimestamp64Milli(ingested_at) > 0\n  AND NOT startsWith(model_version, 'second-look')\nGROUP BY time\nORDER BY time",
          "queryType": "timeseries",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Where the time goes (ms, average)",
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT stage, round(ms, 2) AS ms\nFROM (\n  SELECT avg(stage_kafka_ms) AS a1, avg(stage_handoff_ms) AS a2, avg(stage_decode_ms) AS a3,\n         avg(stage_state_ms) AS a4, avg(stage_redis_ms) AS a5, avg(stage_rules_ms) AS a6,\n         avg(stage_model_ms) AS a7, avg(stage_decide_ms) AS a8\n  FROM fraud.transactions_scored\n  WHERE $__timeFilter(scored_at_job) AND stage_decide_ms IS NOT NULL)\nARRAY JOIN\n  ['into Kafka', 'handed to Python', 'read', 'sender history', 'payee side (Redis)',\n   'features and rules', 'model', 'decision'] AS stage,\n  [a1, a2, a3, a4, a5, a6, a7, a8] AS ms",
          "queryType": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "stage",
        "showValue": "always",
        "legend": {
          "showLegend": false
        }
      }
    },
