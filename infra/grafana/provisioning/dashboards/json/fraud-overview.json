    {
      "id": 5,
      "type": "stat",
      "title": "Median decision time",
      "gridPos": {
        "x": 14,
        "y": 2,
        "w": 5,
        "h": 3
      },
      "description": "Half of the decisions take less than this, from the transfer's arrival. The target is 300 ms.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT quantile(0.5)(toUnixTimestamp64Milli(scored_at_job) - toUnixTimestamp64Milli(ingested_at)) AS value\nFROM fraud.transactions_scored\nWHERE $__timeFilter(scored_at_job) AND toUnixTimestamp64Milli(ingested_at) > 0\n  AND NOT startsWith(model_version, 'second-look')",
          "queryType": "table",
          "format": 1,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
