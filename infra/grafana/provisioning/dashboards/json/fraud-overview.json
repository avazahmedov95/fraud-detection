    {
      "id": 11,
      "type": "timeseries",
      "title": "Transfers checked and held",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 16,
        "h": 8
      },
      "description": "Checked: the left axis. Held for the analyst: the right axis.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT $__timeInterval(scored_at_job) AS time, count() AS checked,\n       countIf(decision = 'REVIEW') AS held\nFROM (SELECT transaction_id, decision, predicted_type, model_version, scored_at_job\n FROM fraud.transactions_scored WHERE $__timeFilter(scored_at_job)\n ORDER BY scored_at DESC LIMIT 1 BY transaction_id)\nGROUP BY time\nORDER BY time",
          "queryType": "timeseries",
          "format": 0,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "noValue": "—",
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3274D9"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "held"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF780A"
                }
              }
            ]
