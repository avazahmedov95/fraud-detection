<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_fraud" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Real-time fraud detection" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_channel" name="Payment channel">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Publish</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_flink" name="Apache Flink job">
        <bpmn:flowNodeRef>Read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Receiver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Features</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Model</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AlertOut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Band</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AllowOut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SecondOut</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_second" name="Second look">
        <bpmn:flowNodeRef>Look</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TabCut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HeldOut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LetGoOut</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_sink" name="Sink writer">
        <bpmn:flowNodeRef>HeldIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HoldMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LetGoIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IsReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Graph</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AlertDone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_data" name="Data stores">
      </bpmn:lane>
      <bpmn:lane id="Lane_case" name="Case manager">
        <bpmn:flowNodeRef>Case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Opened</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_analyst" name="Fraud analyst">
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Verdict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fraud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Blocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Released</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Transfer confirmed by the payer">
      <bpmn:outgoing>F_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Create" name="Create the transfer event&#10;[payment switch, simulated in Python]">
      <bpmn:incoming>F_start</bpmn:incoming>
      <bpmn:outgoing>F_create</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Publish" name="Publish the event&#10;[Kafka: transactions.raw]">
      <bpmn:incoming>F_create</bpmn:incoming>
      <bpmn:outgoing>F_publish</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Read" name="Read and decode the event&#10;[Flink Kafka source]">
      <bpmn:incoming>F_publish</bpmn:incoming>
      <bpmn:outgoing>F_read</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Sender" name="Load the sender's history&#10;[Flink keyed state]">
      <bpmn:incoming>F_read</bpmn:incoming>
      <bpmn:outgoing>F_sender</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Receiver" name="Read and update the receiver's recent payers&#10;[Redis]">
      <bpmn:incoming>F_sender</bpmn:incoming>
      <bpmn:outgoing>F_receiver</bpmn:outgoing>
      <bpmn:property id="Property_Receiver" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="D_redis_read">
        <bpmn:sourceRef>Redis</bpmn:sourceRef>
        <bpmn:targetRef>Property_Receiver</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="D_redis_write">
        <bpmn:targetRef>Redis</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Features" name="Compute the features&#10;[Python in Flink]">
      <bpmn:incoming>F_receiver</bpmn:incoming>
      <bpmn:outgoing>F_features</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Split">
      <bpmn:incoming>F_features</bpmn:incoming>
      <bpmn:outgoing>F_to_rules</bpmn:outgoing>
      <bpmn:outgoing>F_to_model</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:businessRuleTask id="Rules" name="Check the hard rules, name the alert type&#10;[Python in Flink]">
      <bpmn:incoming>F_to_rules</bpmn:incoming>
      <bpmn:outgoing>F_rules</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Model" name="Score the risk&#10;[LightGBM via ONNX Runtime]">
      <bpmn:incoming>F_to_model</bpmn:incoming>
      <bpmn:outgoing>F_model</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Join">
      <bpmn:incoming>F_rules</bpmn:incoming>
      <bpmn:incoming>F_model</bpmn:incoming>
      <bpmn:outgoing>F_join</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:businessRuleTask id="Decision" name="Decide from the model score and the rule results&#10;[Python in Flink]">
      <bpmn:incoming>F_join</bpmn:incoming>
      <bpmn:outgoing>F_decided</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Decide" name="Hold the transfer?" default="F_not_held">
      <bpmn:incoming>F_decided</bpmn:incoming>
      <bpmn:outgoing>F_alert</bpmn:outgoing>
      <bpmn:outgoing>F_not_held</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="AlertOut" name="Hold the transfer, publish the alert&#10;[Kafka: transactions.scored, fraud.alerts]">
      <bpmn:incoming>F_alert</bpmn:incoming>
      <bpmn:outgoing>F_alert_out</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Band" name="Just under the cut-off?" default="F_allow">
      <bpmn:incoming>F_not_held</bpmn:incoming>
      <bpmn:outgoing>F_allow</bpmn:outgoing>
      <bpmn:outgoing>F_second</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="AllowOut" name="Publish the decision ALLOW&#10;[Kafka: transactions.scored]">
      <bpmn:incoming>F_allow</bpmn:incoming>
      <bpmn:outgoing>F_allow_out</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SecondOut" name="Hold it for a second look&#10;[Kafka: fraud.second_look]">
      <bpmn:incoming>F_second</bpmn:incoming>
      <bpmn:outgoing>F_second_out</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Look" name="Score it with TabPFN, publish the decision&#10;[Python, TabPFN]">
      <bpmn:incoming>F_second_out</bpmn:incoming>
      <bpmn:outgoing>F_look</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="TabCut" name="TabPFN at or above its cut-off?" default="F_letgo">
      <bpmn:incoming>F_look</bpmn:incoming>
      <bpmn:outgoing>F_held</bpmn:outgoing>
      <bpmn:outgoing>F_letgo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="HeldOut" name="Held by the second look">
      <bpmn:incoming>F_held</bpmn:incoming>
      <bpmn:linkEventDefinition id="Link_HeldOut" name="Held by the second look" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="LetGoOut" name="Let go by the second look">
      <bpmn:incoming>F_letgo</bpmn:incoming>
      <bpmn:linkEventDefinition id="Link_LetGoOut" name="Let go by the second look" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="HeldIn" name="Held by the second look">
      <bpmn:outgoing>F_held_in</bpmn:outgoing>
      <bpmn:linkEventDefinition id="Link_HeldIn" name="Held by the second look" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="HoldMerge">
      <bpmn:incoming>F_alert_out</bpmn:incoming>
      <bpmn:incoming>F_held_in</bpmn:incoming>
      <bpmn:outgoing>F_to_fork</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Fork">
      <bpmn:incoming>F_to_fork</bpmn:incoming>
      <bpmn:outgoing>F_to_merge</bpmn:outgoing>
      <bpmn:outgoing>F_to_case</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Merge">
      <bpmn:incoming>F_to_merge</bpmn:incoming>
      <bpmn:incoming>F_allow_out</bpmn:incoming>
      <bpmn:incoming>F_letgo_in</bpmn:incoming>
      <bpmn:outgoing>F_merge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="LetGoIn" name="Let go by the second look">
      <bpmn:outgoing>F_letgo_in</bpmn:outgoing>
      <bpmn:linkEventDefinition id="Link_LetGoIn" name="Let go by the second look" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Store" name="Store the decision and its audit record&#10;[Python → ClickHouse]">
      <bpmn:incoming>F_merge</bpmn:incoming>
      <bpmn:outgoing>F_store</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="D_store">
        <bpmn:targetRef>Warehouse</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="IsReview" name="Is the transfer held?" default="F_allowed">
      <bpmn:incoming>F_store</bpmn:incoming>
      <bpmn:outgoing>F_allowed</bpmn:outgoing>
      <bpmn:outgoing>F_to_graph</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Allowed" name="Transfer allowed and recorded">
      <bpmn:incoming>F_allowed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Graph" name="Add the alert to the graph&#10;[Python → Neo4j]">
      <bpmn:incoming>F_to_graph</bpmn:incoming>
      <bpmn:outgoing>F_graph</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="D_graph">
        <bpmn:targetRef>GraphDb</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="AlertDone" name="Alert recorded">
      <bpmn:incoming>F_graph</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Case" name="Open a case with its reasons&#10;[Python service]">
      <bpmn:incoming>F_to_case</bpmn:incoming>
      <bpmn:outgoing>F_case</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="D_case">
        <bpmn:targetRef>Cases</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="Opened" name="Case opened">
      <bpmn:incoming>F_case</bpmn:incoming>
      <bpmn:outgoing>F_opened</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="Review" name="Review the held transfer&#10;[analyst queue: demo page or CLI]">
      <bpmn:incoming>F_opened</bpmn:incoming>
      <bpmn:outgoing>F_review</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Verdict" name="Decide: block it or release it&#10;[saved to ClickHouse]">
      <bpmn:incoming>F_review</bpmn:incoming>
      <bpmn:outgoing>F_verdict</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="D_verdict">
        <bpmn:targetRef>Cases</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Fraud" name="Fraud?" default="F_release">
      <bpmn:incoming>F_verdict</bpmn:incoming>
      <bpmn:outgoing>F_block</bpmn:outgoing>
      <bpmn:outgoing>F_release</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Blocked" name="Transfer blocked">
      <bpmn:incoming>F_block</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Released" name="Transfer released">
      <bpmn:incoming>F_release</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="Redis" name="Redis: receivers' recent payers" />
    <bpmn:dataStoreReference id="Cases" name="ClickHouse: cases and verdicts" />
    <bpmn:dataStoreReference id="Warehouse" name="ClickHouse: decisions, audit log" />
    <bpmn:dataStoreReference id="GraphDb" name="Neo4j: alert graph" />
    <bpmn:sequenceFlow id="F_start" sourceRef="Start" targetRef="Create" />
    <bpmn:sequenceFlow id="F_create" sourceRef="Create" targetRef="Publish" />
    <bpmn:sequenceFlow id="F_publish" sourceRef="Publish" targetRef="Read" />
    <bpmn:sequenceFlow id="F_read" sourceRef="Read" targetRef="Sender" />
    <bpmn:sequenceFlow id="F_sender" sourceRef="Sender" targetRef="Receiver" />
    <bpmn:sequenceFlow id="F_receiver" sourceRef="Receiver" targetRef="Features" />
    <bpmn:sequenceFlow id="F_features" sourceRef="Features" targetRef="Split" />
    <bpmn:sequenceFlow id="F_to_rules" sourceRef="Split" targetRef="Rules" />
    <bpmn:sequenceFlow id="F_to_model" sourceRef="Split" targetRef="Model" />
    <bpmn:sequenceFlow id="F_rules" sourceRef="Rules" targetRef="Join" />
    <bpmn:sequenceFlow id="F_model" sourceRef="Model" targetRef="Join" />
    <bpmn:sequenceFlow id="F_join" sourceRef="Join" targetRef="Decision" />
    <bpmn:sequenceFlow id="F_decided" sourceRef="Decision" targetRef="Decide" />
    <bpmn:sequenceFlow id="F_alert" name="Yes" sourceRef="Decide" targetRef="AlertOut" />
    <bpmn:sequenceFlow id="F_not_held" name="No" sourceRef="Decide" targetRef="Band" />
    <bpmn:sequenceFlow id="F_allow" name="No" sourceRef="Band" targetRef="AllowOut" />
    <bpmn:sequenceFlow id="F_second" name="Yes" sourceRef="Band" targetRef="SecondOut" />
    <bpmn:sequenceFlow id="F_second_out" sourceRef="SecondOut" targetRef="Look" />
    <bpmn:sequenceFlow id="F_look" sourceRef="Look" targetRef="TabCut" />
    <bpmn:sequenceFlow id="F_held" name="Yes" sourceRef="TabCut" targetRef="HeldOut" />
    <bpmn:sequenceFlow id="F_letgo" name="No" sourceRef="TabCut" targetRef="LetGoOut" />
    <bpmn:sequenceFlow id="F_alert_out" sourceRef="AlertOut" targetRef="HoldMerge" />
    <bpmn:sequenceFlow id="F_held_in" sourceRef="HeldIn" targetRef="HoldMerge" />
    <bpmn:sequenceFlow id="F_to_fork" sourceRef="HoldMerge" targetRef="Fork" />
    <bpmn:sequenceFlow id="F_to_merge" sourceRef="Fork" targetRef="Merge" />
    <bpmn:sequenceFlow id="F_to_case" sourceRef="Fork" targetRef="Case" />
    <bpmn:sequenceFlow id="F_allow_out" sourceRef="AllowOut" targetRef="Merge" />
    <bpmn:sequenceFlow id="F_letgo_in" sourceRef="LetGoIn" targetRef="Merge" />
    <bpmn:sequenceFlow id="F_merge" sourceRef="Merge" targetRef="Store" />
    <bpmn:sequenceFlow id="F_store" sourceRef="Store" targetRef="IsReview" />
    <bpmn:sequenceFlow id="F_allowed" name="No" sourceRef="IsReview" targetRef="Allowed" />
    <bpmn:sequenceFlow id="F_to_graph" name="Yes" sourceRef="IsReview" targetRef="Graph" />
    <bpmn:sequenceFlow id="F_graph" sourceRef="Graph" targetRef="AlertDone" />
    <bpmn:sequenceFlow id="F_case" sourceRef="Case" targetRef="Opened" />
    <bpmn:sequenceFlow id="F_opened" sourceRef="Opened" targetRef="Review" />
    <bpmn:sequenceFlow id="F_review" sourceRef="Review" targetRef="Verdict" />
    <bpmn:sequenceFlow id="F_verdict" sourceRef="Verdict" targetRef="Fraud" />
    <bpmn:sequenceFlow id="F_block" name="Yes" sourceRef="Fraud" targetRef="Blocked" />
    <bpmn:sequenceFlow id="F_release" name="No" sourceRef="Fraud" targetRef="Released" />
    <bpmn:textAnnotation id="Note_decision">
      <bpmn:text>Hold (REVIEW) when the model score is at or above the alert cut-off, or a mandatory rule fired; otherwise allow</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_decision_link" sourceRef="Decision" targetRef="Note_decision" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="3260" height="1400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_channel_di" bpmnElement="Lane_channel" isHorizontal="true">
        <dc:Bounds x="190" y="60" width="3230" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_flink_di" bpmnElement="Lane_flink" isHorizontal="true">
        <dc:Bounds x="190" y="220" width="3230" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_second_di" bpmnElement="Lane_second" isHorizontal="true">
        <dc:Bounds x="190" y="580" width="3230" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_sink_di" bpmnElement="Lane_sink" isHorizontal="true">
        <dc:Bounds x="190" y="760" width="3230" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_data_di" bpmnElement="Lane_data" isHorizontal="true">
        <dc:Bounds x="190" y="1020" width="3230" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_case_di" bpmnElement="Lane_case" isHorizontal="true">
        <dc:Bounds x="190" y="1160" width="3230" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_analyst_di" bpmnElement="Lane_analyst" isHorizontal="true">
        <dc:Bounds x="190" y="1310" width="3230" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="232" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="195" y="162" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Create_di" bpmnElement="Create">
        <dc:Bounds x="310" y="90" width="180" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Publish_di" bpmnElement="Publish">
        <dc:Bounds x="530" y="90" width="180" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Read_di" bpmnElement="Read">
        <dc:Bounds x="530" y="350" width="180" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sender_di" bpmnElement="Sender">
        <dc:Bounds x="750" y="350" width="180" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Receiver_di" bpmnElement="Receiver">
        <dc:Bounds x="970" y="350" width="180" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Features_di" bpmnElement="Features">
        <dc:Bounds x="1190" y="350" width="180" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Split_di" bpmnElement="Split">
        <dc:Bounds x="1410" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Rules_di" bpmnElement="Rules">
        <dc:Bounds x="1500" y="235" width="180" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Model_di" bpmnElement="Model">
        <dc:Bounds x="1500" y="465" width="180" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Join_di" bpmnElement="Join">
        <dc:Bounds x="1720" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Decision_di" bpmnElement="Decision">
        <dc:Bounds x="1810" y="350" width="180" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Decide_di" bpmnElement="Decide" isMarkerVisible="true">
        <dc:Bounds x="2030" y="375" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1995" y="347" width="120" height="20" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AlertOut_di" bpmnElement="AlertOut">
        <dc:Bounds x="2130" y="465" width="180" height="100" />
