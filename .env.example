# Template for .env, which is not tracked: copy this file to .env and set your
# own passwords there, so they stay on your machine.
#
# ---------------------------------------------------------------------------
# Image versions
# ---------------------------------------------------------------------------
KAFKA_IMAGE=apache/kafka:3.8.0
REDIS_IMAGE=redis:7-alpine
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8
FLINK_VERSION=1.19.1
GRAFANA_IMAGE=grafana/grafana:11.1.0

# ---------------------------------------------------------------------------
# Credentials  (DEVELOPMENT ONLY — set your own)
# ---------------------------------------------------------------------------
CLICKHOUSE_USER=fraud
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=fraud
GRAFANA_PASSWORD=

# Payload encryption key, AES-256 (64 hex characters), for example from
#   python -c "import secrets; print(secrets.token_hex(32))"
# Setting it does not turn encryption on: the job decrypts only the records that
# arrive encrypted (`kafka_producer.py --encrypt`).
PAYLOAD_KEY_HEX=

# ---------------------------------------------------------------------------
# Host ports  (left side of the mapping — change if a port is already in use)
# ---------------------------------------------------------------------------
KAFKA_HOST_PORT=29092
REDIS_HOST_PORT=6379
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
FLINK_UI_PORT=8081
GRAFANA_PORT=3000
DEMO_PORT=8090

# TabPFN weights for the second look, fetched by hand (second-look/README.md),
# relative to this directory. Left empty, only the second-look service stops.
TABPFN_CHECKPOINT=

# How often the retrainer service retrains the model on the logged decisions and
# the verdicts (ml/README.md, Retraining); a person still promotes the result.
RETRAIN_EVERY_HOURS=168
